{
  // The declaration build for this package: runtime source only. Vite emits
  // the JavaScript; tsc emits declarations to `dist/`. Tests are type-checked
  // by the root tsconfig.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"]
}
