{
  // The development project: every package's source and tests. `typecheck` and
  // the Effect language service gate (`lint:effect`) both read this file, so a
  // test file gets the same type-aware checks as runtime source.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts"]
}
