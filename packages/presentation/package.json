{
  "name": "@jambudipa/presentation",
  "version": "0.1.0",
  "description": "Provenanced jam-flow V1 presentation wire data and stable Effect 4 validators.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jambudipa/agent-protocols.git",
    "directory": "packages/presentation"
  },
  "homepage": "https://github.com/jambudipa/agent-protocols/tree/master/packages/presentation#readme",
  "bugs": {
    "url": "https://github.com/jambudipa/agent-protocols/issues"
  },
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js",
      "default": "./dist/wire/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PROVENANCE.md",
    "upstream-sources.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.dev.json --noEmit",
    "test": "vitest run test",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "effect": "~4.0.6"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "effect": "~4.0.6"
  }
}
