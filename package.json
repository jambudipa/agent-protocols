{
  "name": "agent-protocols",
  "version": "0.0.0",
  "private": true,
  "description": "Native Effect v4 implementations of the agent protocols.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jambudipa/agent-protocols.git"
  },
  "homepage": "https://github.com/jambudipa/agent-protocols#readme",
  "bugs": {
    "url": "https://github.com/jambudipa/agent-protocols/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "npm run lint:eslint; e=$?; npm run lint:effect; f=$?; exit $(( e > f ? e : f ))",
    "lint:eslint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings=0",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --format text --severity ${EFFECT_SEVERITY:-error,warning} --strict",
    "lint:effect:all": "EFFECT_SEVERITY=error,warning,message npm run lint:effect",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "~4.0.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
