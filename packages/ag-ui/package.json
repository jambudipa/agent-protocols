{
  "name": "@jambudipa/ag-ui",
  "version": "0.1.0",
  "description": "AG-UI 1.0 server and client for Effect v4, over SSE and protobuf.",
  "keywords": [
    "effect",
    "ag-ui",
    "agent-ui",
    "ai-agents",
    "sse",
    "protobuf"
  ],
  "author": "jambudipa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jambudipa/agent-protocols.git",
    "directory": "packages/ag-ui"
  },
  "homepage": "https://github.com/jambudipa/agent-protocols/tree/master/packages/ag-ui#readme",
  "bugs": {
    "url": "https://github.com/jambudipa/agent-protocols/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./proto": {
      "types": "./dist/proto/index.d.ts",
      "import": "./dist/proto/index.js",
      "default": "./dist/proto/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "buf generate",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@effect/platform-node": "~4.1.4",
    "effect": "~4.1.4"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.4",
    "@ag-ui/core": "1.0.4",
    "@ag-ui/encoder": "1.0.4",
    "@ag-ui/proto": "1.0.4",
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@effect/platform-node": "~4.1.4",
    "effect": "~4.1.4",
    "zod": "^4.6.7"
  }
}
